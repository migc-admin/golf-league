# Supabase (publishable — safe to expose in browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Sentry error monitoring (publishable — safe to expose in browser)
VITE_SENTRY_DSN=https://your-key@oXXXX.ingest.us.sentry.io/XXXX

# Google Analytics 4 (publishable — safe to expose in browser)
VITE_GA_ID=G-XXXXXXXXXX

# MIGC org ID for org-specific feature gating (wager board, etc.)
VITE_MIGC_ORG_ID=your-migc-org-uuid-here

# All other secrets (API keys, service role key, Stripe secret, webhook secret)
# are stored as Supabase Edge Function secrets — never in this file.
# Set them with: supabase secrets set KEY=value
